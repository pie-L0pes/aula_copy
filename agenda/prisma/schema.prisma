generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}
model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  agendamentos Agendamento[]
}

model Agendamento {
  id            Int      @id @default(autoincrement())
  data          String
  horarioInicio String
  horarioFim    String
  usuarioId     Int
  criadoEm      DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])
}